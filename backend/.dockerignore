# backend/.dockerignore
#
# Files left out of the backend image
# ─────────────────────────────────────────────────────────────────────────────
# Whatever is listed here is not sent to Docker when the image is built.

# Local development database
*.sqlite3

# Python caches
__pycache__/
*.pyc

# Static files collected locally: the container collects its own
staticfiles/

# Files sent by the users on a development machine: never in the image
media/

# Documentation, not needed to build or run the application
docs/

# Docker files themselves
Dockerfile
.dockerignore
