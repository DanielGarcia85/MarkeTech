############################################
# OS
############################################
# Hidden file generated by macOS
.DS_Store
# Hidden file generated by Windows (previews)
Thumbs.db

############################################
# VS Code
############################################
# Ignore all local VS Code configuration
.vscode/*
# But keep the list of recommended extensions
!.vscode/extensions.json

############################################
# Python
############################################
# Automatically compiled Python cache
__pycache__/
# Compiled Python files (.pyc, .pyo, .pyd)
*.py[cod]
# Old Python bytecode format
*.pyo
# Compiled Python extensions (Windows)
*.pyd

############################################
# Django
############################################
# Local SQLite development database
*.sqlite3
# Collected static files (generated by collectstatic)
staticfiles/
# Uploaded files (user content)
media/

############################################
# Node
############################################
# Locally installed Node dependencies
node_modules/
# Frontend built (generated by Vite)
dist/

############################################
# Virtual Environments
############################################
# Classic virtual environment variant
.venv/
# Variante classique d’environnement virtuel
venv/
# Another variant of virtual environment
env/

############################################
# Env files / Secrets
############################################
# File containing secrets (never versioned)
.env
# Local variants (.env.dev, .env.prod, etc.)
.env.*
# Public example of environment variables
!.env.example

############################################
# Logs
############################################
# Generated log folders
logs/
# All .log files
*.log

############################################
# Docker
############################################
# Exported Docker image archives
*.tar
