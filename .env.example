# Django settings
DJANGO_SETTINGS_MODULE=config.settings.xxx      # => Django settings module
DJANGO_SECRET_KEY=xxx_your-secret-key-here      # => Secret key for Django
DJANGO_DEBUG=True                               # => Debug mode (True for dev, False for prod)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1        # => Allowed hosts separated by commas
DJANGO_SUPERUSER_USERNAME=admin                 # => Django superuser username
DJANGO_SUPERUSER_PASSWORD=admin                 # => Django superuser password
DJANGO_SUPERUSER_EMAIL=admin@admin.com          # => Django superuser email

# Database for dev
POSTGRES_DB=xxx_db                              # => PostgreSQL database name
POSTGRES_USER=xxx_user                          # => PostgreSQL username
POSTGRES_PASSWORD=xxx_your-db-password          # => PostgreSQL username
POSTGRES_HOST=localhost                         # => PostgreSQL host (localhost or Docker service name)
POSTGRES_PORT=5432                              # => PostgreSQL port (default: 5432)
