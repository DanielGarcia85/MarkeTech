# .env.example
#
# Environment variables template — copy to .env and fill in the values
# ─────────────────────────────────────────────────────────────────────────────
# This file is versioned and contains no real secret. Every variable read by
# the code must be listed here.

# ── Django ───────────────────────────────────────────────────────────────────

# Secret key used to sign sessions and tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# Administrator account, created by the backend container the first time it
# starts. All three values are required: if one is empty, no account is
# created.
DJANGO_SUPERUSER_USERNAME=change-me
DJANGO_SUPERUSER_EMAIL=change-me
DJANGO_SUPERUSER_PASSWORD=change-me

# Host names the application agrees to answer for, separated by commas and
# without spaces. Read by the production settings only.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── PostgreSQL ───────────────────────────────────────────────────────────────

# Database, user and password. The PostgreSQL container creates them the
# first time it starts, and the backend uses them to connect. Read by the
# production settings only: development runs on SQLite.
POSTGRES_DB=marketech
POSTGRES_USER=marketech
POSTGRES_PASSWORD=change-me
