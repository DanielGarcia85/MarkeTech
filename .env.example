# .env.example
#
# Local environment variables — secrets and machine-specific settings.
# ─────────────────────────────────────────────────────────────────────────────
# This file is the template — it is versioned and contains no real secret.
# Copy to .env and fill in the values.
# Every variable read by the code must be listed here.

# ── Django ───────────────────────────────────────────────────────────────────

# Secret key used to sign sessions and tokens.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# Administrator account, created by the backend container the first time it
# starts. Both values are required: if one is empty, no account is created.
DJANGO_SUPERUSER_EMAIL=change-me
DJANGO_SUPERUSER_PASSWORD=change-me

# Host names the application agrees to answer for, separated by commas and
# without spaces. Read by the production settings only.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── E-mail ───────────────────────────────────────────────────────────────────

# Outgoing mail server and the login of the mailbox that sends the
# application's e-mails (address verification, password reset). Read by the
# production settings only: development prints e-mails in the terminal.
EMAIL_HOST=mail.infomaniak.com
EMAIL_PORT=587
EMAIL_HOST_USER=change-me
EMAIL_HOST_PASSWORD=change-me

# Address shown as the sender: the mailbox above or one of its aliases,
# with an optional display name, as in: MarkeTech <noreply@example.com>
DEFAULT_FROM_EMAIL=change-me

# ── PostgreSQL ───────────────────────────────────────────────────────────────

# Database, user and password. The PostgreSQL container creates them the
# first time it starts, and the backend uses them to connect. Read by the
# production settings only: development runs on SQLite.
POSTGRES_DB=marketech
POSTGRES_USER=marketech
POSTGRES_PASSWORD=change-me

# ── Docker ───────────────────────────────────────────────────────────────────

# Version of the application images run by Docker Compose: "latest" for the
# most recent one published, or "sha-" followed by the first seven characters
# of a commit of main, to stay on that exact version.
IMAGE_TAG=latest
