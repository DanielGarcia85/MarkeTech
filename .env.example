# .env.example
#
# Environment variables template — copy to .env and fill in the values
# ─────────────────────────────────────────────────────────────────────────────
# This file is versioned and contains no real secret. Every variable read by
# the code must be listed here.

# ── Django ───────────────────────────────────────────────────────────────────

# Secret key used to sign sessions and tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# Administrator account, created by the backend container the first time it
# starts. All three values are required: if one is empty, no account is
# created.
DJANGO_SUPERUSER_USERNAME=change-me
DJANGO_SUPERUSER_EMAIL=change-me
DJANGO_SUPERUSER_PASSWORD=change-me
