# .env.example
#
# Environment variables template — copy to .env and fill in the values
# ─────────────────────────────────────────────────────────────────────────────
# This file is versioned and contains no real secret. Every variable read by
# the code must be listed here.

# ── Django ────────────────────────────────────────────────────────────
# Secret key used to sign sessions and tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
